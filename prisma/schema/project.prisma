model Project {
    id       String  @id @default(uuid())
    name     String
    role     String?
    slug     String  @unique
    category String
    status   String  @default("Live")

    thumbnail String?
    gallery   String[]

    shortDescription String   @db.Text
    topFeatures      String[]

    fullDescription String   @db.Text
    clientSideTech  String[]
    serverSideTech  String[]
    databaseTech    String
    authTech        String?
    usedLibraries   String[]

    challenges       String   @db.Text
    solutions        String   @db.Text
    learningOutcomes String   @db.Text
    futurePlans      String[]

    // Links & Meta
    liveLink     String?
    githubClient String?
    githubServer String?
    isFeatured   Boolean @default(false)
    complexity   Int     @default(1)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("projects")
}

