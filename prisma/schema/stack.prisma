model Skill {
    id       String        @id @default(uuid())
    name     String        @unique
    iconUrl  String?
    category SkillCategory
    status   SkillStatus

    priority    Int @default(0)
    proficiency Int @default(0)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

enum SkillCategory {
    FRONTEND
    BACKEND
    DATABASE
    DEVOPS
    TOOLS
    LANGUAGE
}

enum SkillStatus {
    WORKING_WITH
    LEARNING
    FUTURE_PLAN
}
